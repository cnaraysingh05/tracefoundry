<?xml version="1.0"?>

-<Sysmon schemaversion="4.91">

<HashAlgorithms>sha256</HashAlgorithms>


-<EventFiltering>

<!-- Event ID 1: All process creation -->


<ProcessCreate onmatch="exclude"/>

<!-- Event ID 3: All network connections -->


<NetworkConnect onmatch="exclude"/>

<!-- Event ID 11: All file creation -->


<FileCreate onmatch="exclude"/>

<!-- Event IDs 12, 13, 14: All registry activity -->


<RegistryEvent onmatch="exclude"/>

</EventFiltering>

</Sysmon>
